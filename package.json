{
  "name": "rag-nuxt",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "scrape": "node scripts/scrape-cars.ts",
    "describe": "node --env-file-if-exists=.env scripts/describe-cars.ts",
    "ingest": "node --env-file-if-exists=.env scripts/ingest-cars.ts",
    "screenshot": "node scripts/screenshot.ts",
    "browser:install": "playwright install chromium-headless-shell",
    "typecheck": "nuxt typecheck && tsc -p scripts",
    "typecheck:scripts": "tsc -p scripts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "mongodb": "^7.8.0",
    "nuxt": "^4.6.4",
    "openai": "^7.53.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
