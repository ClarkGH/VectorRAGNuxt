{
  // Standalone Node scripts: Nuxt's strict node config, plus Node's types.
  // erasableSyntaxOnly keeps the code runnable by Node's built-in type stripping.
  "extends": "../.nuxt/tsconfig.node.json",
  "compilerOptions": {
    "types": ["node"],
    "erasableSyntaxOnly": true
  },
  "include": ["./**/*.ts"]
}
