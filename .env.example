# Copy to .env and fill in. Nuxt maps NUXT_* onto runtimeConfig (mongodbUri, openaiKey).
# Local Mongo: run the container bound to 127.0.0.1 (see docs/specs/ingest-search.md, S5).
# The /vector_rag path picks the database; without it Mongo falls back to "test".
NUXT_MONGODB_URI=mongodb://localhost:27017/vector_rag?directConnection=true
# Use an OpenAI project key restricted to the endpoints we call, with a monthly budget cap (S4).
NUXT_OPENAI_KEY=
